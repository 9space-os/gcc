#!/bin/rc
# gcc-as: 6a (8a) for mk -- x.s to x.$O through its GAS port x.S beside
# it (9front's .s is 6a syntax), as the build tool assembles; a .s that
# gccmk's aux/data2s wrote is GAS already (the kernel's $CONF.root.s);
# in a kernel's directory with the kernel's flags (lib.rc: $kernel); for
# gccmk
. /$objtype/gnu/plan9/lib.rc
ccargs $*
~ $#files 0 && die no files
~ $#out 0 || ~ $#files 1 || die -o with several files
for(f in $files){
	S=`{echo $f | sed 's/\.s$/.S/'}
	if(! test -r $S){
		~ `{sed 1q $f} $data2s || die $f: no GAS port $S
		S=$f
	}
	o=$out
	~ $#o 0 && o=`{basename $f .s}^.$O
	flags=$asflags
	if(! ~ $#kernel 0 && ! kuser $f)
		flags=$kasflags
	$GNU/gcc -c -I/$objtype/include -I/sys/include -I. $flags $defs -o $o $S || exit $prog
}
exit ''
